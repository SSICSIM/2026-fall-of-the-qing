# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (docker-compose)
# Copy this file to .env in the repo root. Docker defaults are pre-filled.
# This is the ONLY .env file you need — docker-compose passes it into every
# service (db, backend, frontend) via `env_file:`.
#
# Full documentation for every variable below: docs/environment-setup.md
# ─────────────────────────────────────────────────────────────────────────────

# Backend
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/app
API_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Shared secret between the frontend's /api/backend proxy and this API.
# Leave blank in local dev to disable the guard; set it before deploying
# anywhere reachable outside your own network.
ADMIN_API_TOKEN=
# Postgres schema for this mechanic's tables. Leave blank locally; production
# sets it so mechanics can share one database (see docs/deployment.md).
DB_SCHEMA=

# Postgres (docker-compose only)
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Frontend (Next.js)
# The browser never calls the backend directly — it calls this app's own
# /api/backend proxy, which forwards server-side to INTERNAL_API_BASE_URL
# (the backend's address on the docker network). NEXT_PUBLIC_API_BASE_URL is
# inlined into the browser bundle; nothing in the app uses it today, kept for
# convenience if you need to hit the backend (e.g. /docs) from your host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://backend:8000

# Auth — password login
# Set SITE_PASSWORD to whatever the staff password should be.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
SITE_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
